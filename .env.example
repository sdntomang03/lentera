# DEEPSEEK_API_KEY: Required for AI study tips and the "Tanya Endzi" chatbot.
# Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database URL. Keep empty to use the same-origin /api/v1 Vite proxy locally.
VITE_API_BASE_URL=

# Laravel server origin for the production Node.js reverse proxy.
LARAVEL_API_URL=http://127.0.0.1:8000
